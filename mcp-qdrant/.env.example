# Qdrant Knowledge MCP — 环境变量示例
# 复制为 .env 并按需修改，或直接在 opencode.json / 系统环境中设置
# opencode local MCP 也支持在 command 前注入 env，需自行在启动环境中 export

# Qdrant 向量库
QDRANT_URL=http://192.168.1.16:6333
# 复制本文件为 .env 后填入真实 Key，切勿提交 .env
QDRANT_API_KEY=changeme-replace-with-real-key

# Ollama Embedding
OLLAMA_URL=http://192.168.1.232:11434
OLLAMA_MODEL=bge-m3:latest
# 向量维度固定 1024 (bge-m3)，Qdrant 需 Cosine 距离
